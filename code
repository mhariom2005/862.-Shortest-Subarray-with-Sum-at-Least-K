class Solution {
    public int shortestSubarray(int[] nums, int k) {
        int n = nums.length;
        long[] prefix = new long[n + 1];
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        int minLen = n + 1;
        int[] deque = new int[n + 1];
        int head = 0, tail = 0;

        for (int i = 0; i <= n; i++) {
            // Shrink from front while a valid subarray exists
            while (head < tail && prefix[i] - prefix[deque[head]] >= k) {
                minLen = Math.min(minLen, i - deque[head++]);
            }
            // Keep prefix values increasing in the deque
            while (head < tail && prefix[i] <= prefix[deque[tail - 1]]) {
                tail--;
            }
            deque[tail++] = i;
        }

        return minLen <= n ? minLen : -1;
    }
}
